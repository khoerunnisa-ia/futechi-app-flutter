# ============================================================
# Futechi — template konfigurasi.
# Salin file ini menjadi `.env` lalu isi nilainya:
#   Copy-Item .env.example .env
# File `.env` tidak ikut ter-commit (lihat .gitignore).
# ============================================================

# --- Broker MQTT ---
# Host/port broker. 1883 = TCP polos, 8883 = TLS (belum didukung kode ini).
MQTT_HOST=mqtt.stiatech.my.id
MQTT_PORT=1883

# Kredensial broker. Kosongkan hanya jika broker memang tanpa autentikasi.
MQTT_USER=mqttuser
MQTT_PASS=

# --- Topik MQTT ---
# Harus sama persis dengan firmware (pakan-sc/pakanAyam_v2/src/main.cpp):
#   subscribe : client2/set/pakan, client2/set/jadwal
#   publish   : client2/status
MQTT_TOPIC_STATUS=client2/status
MQTT_TOPIC_FEED=client2/set/pakan
MQTT_TOPIC_SCHEDULE=client2/set/jadwal

# --- Identitas klien ---
# WAJIB berbeda dari `ESP32_FEEDER` (client ID firmware). Jika sama, broker
# akan memutus salah satu koneksi (biasanya perangkatnya yang terlempar).
# Boleh dikosongkan → aplikasi memakai ID acak `futechi-app-<8 hex>`.
MQTT_CLIENT_ID=flutter-feeder-unique-01

# --- Backend AI Techi ---
# Base URL deployment react-js yang menyajikan POST /api/chat.
# Untuk perangkat fisik (HP/tablet), localhost tidak bisa dipakai —
# isi IP LAN komputer Anda, mis. http://192.168.1.10:3000
FUTECHI_CHAT_URL=http://localhost:3000